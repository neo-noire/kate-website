# Copy to .env.local for local development.
# Neon pooled connection string (Vercel adds it when the Neon integration is connected).
DATABASE_URL=
# Optional: direct connection for migrations.
DATABASE_URL_UNPOOLED=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated emails of accounts that can manage courses at /admin.
ADMIN_EMAILS=
# Optional: Google sign-in switches on when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe: secret key and the webhook endpoint's signing secret. Checkout stays off until both are set.
# Production (VERCEL_ENV=production) must use a live key (sk_live_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Resend API key. Switches on email verification, password reset, purchase confirmations
# and contact-form notifications. Requires EMAIL_FROM (checked at startup).
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "LatinKate <hello@example.com>". Required with RESEND_API_KEY;
# Resend's test sender (resend.dev) only delivers to your own address and is refused in production.
EMAIL_FROM=
