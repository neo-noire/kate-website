# Copy to .env.local for local development.
# Neon pooled connection string (Vercel adds it when the Neon integration is connected).
DATABASE_URL=
# Optional: direct connection for migrations.
DATABASE_URL_UNPOOLED=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated emails of accounts that can manage courses at /admin.
ADMIN_EMAILS=
# Optional: Google sign-in switches on when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe: secret key and the webhook endpoint's signing secret. Checkout stays off until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: email verification codes (Resend API key). Verification switches on when it is set.
RESEND_API_KEY=
# Sender, on a domain verified in Resend. Defaults to Resend's test sender (only delivers to your own address).
EMAIL_FROM=
